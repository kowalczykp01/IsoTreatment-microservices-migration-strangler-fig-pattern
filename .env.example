# Copy to .env and fill in. .env is git-ignored; this file is not.

# SQL Server sa password. Must satisfy SQL Server's complexity rules
# (8+ characters, at least three of: upper, lower, digit, symbol) or the
# database container starts and immediately exits.
MSSQL_SA_PASSWORD=

# Symmetric HMAC key the monolith uses to sign and validate JWTs. The
# Treatment service will be given the same key, so that both validate the
# same token independently. A temporary bridge, replaced by RS256 + JWKS
# once Identity becomes its own service.
AUTHENTICATION_SIGNING_KEY=

# SMTP account used for registration and password-reset mail. MailkitService
# connects on port 587 with STARTTLS and both values are hardcoded, so the
# host has to offer that. Only /api/user/register and the password-reset
# endpoints touch this; everything else works without it.
EmailHost=
EmailUsername=
EmailPassword=
