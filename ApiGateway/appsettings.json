{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy":
  {
    "Routes": 
    {
      "monolith-route":
      {
        "ClusterId": "monolith",
        "Match":
        {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters":
    {
      "monolith": 
      {
        "Destinations": 
        {
          "primary": 
          {
            "Address": "http://monolith:8080/"
          }
        }
      }
    }
  }
}
