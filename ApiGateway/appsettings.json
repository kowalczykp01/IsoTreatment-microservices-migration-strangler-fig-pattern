{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy":
  {
    "Routes": 
    {
      "monolith-route":
      {
        "ClusterId": "monolith",
        "Order": 2,
        "Match":
        {
          "Path": "{**catch-all}"
        }
      },
      "reminder-canary-route":
      {
        "ClusterId": "treatment",
        "Order": 1,
        "Match":
        {
          "Path": "/api/reminder/{**catch-all}",
          "Headers": 
          [
            {
              "Name": "X-Canary",
              "Values": [ "treatment" ],
              "Mode": "ExactHeader"
            }
          ]
        }
      }
    },
    "Clusters":
    {
      "monolith": 
      {
        "Destinations": 
        {
          "primary": 
          {
            "Address": "http://monolith:8080/"
          }
        }
      },
      "treatment":
      {
        "Destinations":
        {
          "primary":
          {
            "Address": "http://treatment:8080/"
          }
        }
      }
    }
  }
}
